# ============================================================
#  GitHub 多账号管家 · 环境变量模板
#  复制为 .env 后按需修改（.env 已被 git 忽略，不会被提交）
# ============================================================

NODE_ENV=production
HOST=127.0.0.1
PORT=24524

# ---------- Docker 部署（docker compose 使用）----------
# 页面绑定的宿主机 IP：0.0.0.0=公网/局域网可访问，127.0.0.1=仅本机（配合 Nginx 反代）
BIND_IP=0.0.0.0
# MySQL root 密码（仅 Docker 模式的 MySQL 容器使用，用于容器健康检查与管理）
MYSQL_ROOT_PASSWORD=change-root-2026

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ghhub
DB_PASSWORD=change-me-please
DB_NAME=github_hub
DB_POOL_SIZE=10

# ---------- 存储 / 日志 ----------
DATA_DIR=data
LOG_DIR=logs
SECRET_KEY_FILE=data/secret.key

# ---------- GitHub API ----------
GITHUB_TIMEOUT=20000

# ---------- 网页登录（「密码换 Token」功能）----------
# 服务器无法直连 github.com 时需要的初始代理；留空或保持 auto 表示自动探测。
# 部署后也可以在「菜单 → 代理设置」里随时修改（数据库配置优先于此处的值）。
GITHUB_WEB_PROXY=auto
GITHUB_WEB_TIMEOUT=25000

# ---------- 公网部署 ----------
# HTTPS 部署时保持 auto（按请求协议自动为会话 Cookie 加 Secure）；
# 若反代终止 TLS，请确保转发 X-Forwarded-Proto 头，或直接设为 1。
COOKIE_SECURE=auto
